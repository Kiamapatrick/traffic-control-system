 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Traffic Control System - Basic Usage\n",
    "\n",
    "This notebook demonstrates the basic usage of the traffic control system."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "sys.path.insert(0, '../src')\n",
    "\n",
    "from traffic_control import (\n",
    "    generate_four_junction_example,\n",
    "    generate_manhattan_example,\n",
    "    solve_rref,\n",
    "    solve_lp,\n",
    "    solve_milp,\n",
    "    solve_max_flow,\n",
    "    validate_solution,\n",
    "    draw_network,\n",
    "    create_network_figure,\n",
    "    save_network_json,\n",
    "    load_network_json,\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Generate Example Networks"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "four_junc = generate_four_junction_example()\n",
    "manhattan = generate_manhattan_example()\n",
    "roundabout = generate_roundabout_example()\n",
    "\n",
    "print(f\"Four junction: {len(four_junc.junctions)} junctions, {len(four_junc.roads)} roads\")\n",
    "print(f\"Manhattan: {len(manhattan.junctions)} junctions, {len(manhattan.roads)} roads\")\n",
    "print(f\"Roundabout: {len(roundabout.junctions)} junctions, {len(roundabout.roads)} roads\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Solve with Different Methods"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "solution_rref = solve_rref(four_junc)\n",
    "solution_lp = solve_lp(four_junc)\n",
    "solution_milp = solve_milp(four_junc)\n",
    "solution_maxflow = solve_max_flow(four_junc, \"A\", \"C\")\n",
    "\n",
    "print(\"RREF flows:\", {k: f\"{v:.1f}\" for k, v in solution_rref.flows.items()})\n",
    print(\"LP flows:\", {k: f\"{v:.1f}\" for k, v in solution_lp.flows.items()})\n",
    print(\"MILP flows:\", {k: f\"{v:.1f}\" for k, v in solution_milp.flows.items()})\n",
    print(f\"Max flow value: {solution_maxflow.objective_value:.1f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Validate Solutions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "for name, sol in [(\"RREF\", solution_rref), (\"LP\", solution_lp), (\"MILP\", solution_milp)]:\n",
    "    is_valid, violations = validate_solution(four_junc, sol)\n",
    "    print(f\"{name}: Valid={is_valid}, Violations={len(violations)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Visualize Network"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "fig, ax = draw_network(four_junc, solution_rref, figsize=(10, 8))\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Save and Load Network"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "save_network_json(four_junc, \"../data/sample_networks/four_junction.json\")\n",
    "loaded = load_network_json(\"../data/sample_networks/four_junction.json\")\n",
    "print(f\"Loaded: {len(loaded.junctions)} junctions, {len(loaded.roads)} roads\")"
   ]
  }
